{
  "site": {
    "name": "みんなの御朱印マップ",
    "url": "https://goshuin-map.github.io/"
  },
  "repo": "goshuin-map/goshuin-map.github.io",
  "osm": {
    "religion": "shinto",
    "sleepSeconds": 15,
    "endpoints": [
      "https://overpass-api.de/api/interpreter",
      "https://overpass.private.coffee/api/interpreter"
    ]
  },
  "map": {
    "tiles": "light",
    "tileSets": {
      "light": {
        "type": "vector",
        "style": "https://tiles.openfreemap.org/styles/positron",
        "attribution": "© <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\" rel=\"noopener\">OpenStreetMap</a> contributors | <a href=\"https://openfreemap.org\" target=\"_blank\" rel=\"noopener\">OpenFreeMap</a> © <a href=\"https://www.openmaptiles.org/\" target=\"_blank\" rel=\"noopener\">OpenMapTiles</a>"
      },
      "gsi-pale": {
        "url": "https://cyberjapandata.gsi.go.jp/xyz/pale/{z}/{x}/{y}.png",
        "maxNativeZoom": 18,
        "attribution": "© OpenStreetMap contributors（神社データ） | <a href=\"https://maps.gsi.go.jp/development/ichiran.html\" target=\"_blank\" rel=\"noopener\">地理院タイル</a>"
      },
      "osm": {
        "url": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
        "attribution": "© <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\" rel=\"noopener\">OpenStreetMap</a> contributors"
      }
    },
    "unnamedMinZoom": 15,
    "newPinMinZoom": 16,
    "maxPrefectures": 8
  },
  "form": {
    "post": {
      "url": "",
      "entries": {
        "kind": "",
        "id": "",
        "name": "",
        "lat": "",
        "lon": "",
        "pref": ""
      },
      "kindValues": {
        "new": "新しい情報",
        "fix": "修正の報告"
      }
    },
    "contact": {
      "url": ""
    }
  },
  "analytics": {
    "goatcounter": ""
  }
